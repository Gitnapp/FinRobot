{
  "name": "@gitnapp/ui",
  "version": "0.1.0",
  "description": "rational-ui 共享 shadcn 组件库。基于 @gitnapp/design-tokens 主题，语义真相源：根 design.md。",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitnapp/rational-ui",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "files": [
    "src",
    "scripts/assert-customization-markers.mjs"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && node scripts/assert-customization-markers.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.545.0",
    "radix-ui": "1.4.3",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4",
    "jsdom": "^26",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
